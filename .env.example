# Personal access token minted in Kalendia > Settings > API tokens (starts with kld_).
KALENDIA_TOKEN=kld_replace_me

# API base URL. Prod default is https://api.kalendia.io.
# Point at your local backend (http://localhost:8002) to test against `make dev`.
KALENDIA_API_URL=https://api.kalendia.io

# Optional: DEBUG / INFO / WARNING / ERROR (default INFO).
KALENDIA_LOG_LEVEL=INFO
